{
  "name": "wenhuo",
  "version": "0.1.0",
  "private": true,
  "description": "文火 · 本地优先的长篇写作工作台",
  "author": "wenhuo",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:local": "node scripts/dev-local.cjs",
    "postinstall": "node scripts/ensure-electron.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "gen:ipc": "node scripts/gen-ipc-doc.cjs",
    "perf:baseline": "node scripts/perf-baseline.cjs 170",
    "diagnose:launch": "node scripts/diagnose-launch.cjs",
    "perf:ui": "electron-vite build && playwright test --config playwright.perf.config.ts",
    "test:watch": "vitest",
    "smoke:db": "electron --no-sandbox scripts/db-smoke.cjs",
    "simulate:crash": "node scripts/simulate-crash.cjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dist:win": "pnpm run build && electron-builder --win --config electron-builder.yml && node scripts/make-launcher-shortcut.cjs",
    "dist:win:zip": "pnpm run build && electron-builder --win zip --config electron-builder.yml && node scripts/make-launcher-shortcut.cjs",
    "dist:win:portable": "pnpm run build && electron-builder --win portable --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
